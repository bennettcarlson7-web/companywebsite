# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Everything is optional. With nothing set, the site runs in a safe "fail closed" mode: indexing is off, and both
# forms show an honest "not sent" state with a prefilled email to the business inbox instead of a fake success.

# ── Public site settings (inlined at BUILD time — redeploy after changing) ───────────────────────────────────
# Canonical base URL, no trailing slash. Enables canonical tags, absolute OG URLs, JSON-LD, and sitemap hosts.
NEXT_PUBLIC_SITE_URL=
# "true" ONLY on the production deployment, once content and legal pages are final. Never on previews.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Official social profiles (leave empty to hide). Only add URLs you have verified.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# Real booking page (Cal.com, Calendly, HubSpot Meetings…). Read on the server at build time.
# Leave empty and the site asks visitors to request a call by email instead.
BOOKING_URL=

# ── Email delivery (server-only secrets; read per request by /api/inquiry and /api/apply) ───────────────────
# Option A (recommended): send through the company mailbox over SMTP.
# mentortech.space is hosted on Namecheap Private Email; its SPF record already authorizes this server.
SMTP_HOST=mail.privateemail.com
# 465 = SSL/TLS (default). 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=rpatdu@mentortech.space
# The mailbox password. Set it in .env.local / Vercel only — never commit it or paste it into chat.
SMTP_PASSWORD=

# Option B: Resend API instead of SMTP (used only when SMTP isn't configured).
RESEND_API_KEY=

# Sender shown on notifications. With SMTP it defaults to "Nextmade Website <SMTP_USER>"; keep the address equal
# to the mailbox (Private Email rejects other senders). With Resend it must be on a domain verified in Resend.
# Visitors/candidates are only ever set as reply-to, never as the sender.
EMAIL_FROM=
# Where project inquiries go. Default: rpatdu@mentortech.space (owner-supplied business email).
BUSINESS_CONTACT_EMAIL=
# Where job applications go. Default: BUSINESS_CONTACT_EMAIL. Use a restricted hiring inbox if available.
HIRING_EMAIL=

# ── Optional integrations ─────────────────────────────────────────────────────────────────────────────────────
# HubSpot private-app token (scope: crm.objects.contacts.write). Project inquiries only — never applications.
HUBSPOT_ACCESS_TOKEN=
# Distributed rate limiting (strongly recommended on Vercel/serverless). Without it, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-IP limit for each form, separately. Defaults: 5 submissions per 600 seconds.
INTAKE_RATE_LIMIT_MAX=
INTAKE_RATE_LIMIT_WINDOW_SECONDS=
