# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Everything is optional. With nothing set, the site runs in a safe "fail closed" mode: indexing is off, and both
# forms show an honest "not sent" state with a prefilled email to the business inbox instead of a fake success.

# ── Public site settings (inlined at BUILD time — redeploy after changing) ───────────────────────────────────
# Canonical base URL, no trailing slash. Defaults to https://nextmadelabs.com; override only for a staging host.
NEXT_PUBLIC_SITE_URL=
# "true" ONLY on the production deployment, once content and legal pages are final. Never on previews.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Official social profiles (leave empty to hide). Only add URLs you have verified.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# Real booking page (Cal.com, Calendly, HubSpot Meetings…). Read on the server at build time.
# Leave empty and the site asks visitors to request a call by email instead.
BOOKING_URL=

# ── Email delivery (server-only secrets; read per request by /api/inquiry and /api/apply) ───────────────────
# Receiving: Cloudflare Email Routing forwards hello@ and careers@nextmadelabs.com to the team's mailbox.
# Sending: this site needs ONE provider below. See docs/EMAIL_SETUP.md for the DNS steps.

# Option A (recommended): Resend, sending as notifications@nextmadelabs.com once the domain is verified in Resend.
# Mark it Sensitive in Vercel. Never commit it or paste it into chat.
RESEND_API_KEY=

# Option B (fallback, used only when RESEND_API_KEY is empty): SMTP through an existing mailbox.
# The mailbox can only send as itself, e.g. Namecheap Private Email for rpatdu@mentortech.space.
SMTP_HOST=
# 465 = SSL/TLS (default). 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Sender shown on emails. Default: "Nextmade <notifications@nextmadelabs.com>" with Resend, or the SMTP mailbox.
# Visitors/candidates are only ever set as reply-to on notifications, never as the sender.
EMAIL_FROM=
# Where project inquiries go. Default: hello@nextmadelabs.com.
BUSINESS_CONTACT_EMAIL=
# Where job applications go. Default: careers@nextmadelabs.com.
HIRING_EMAIL=
# "true" sends a short "we received it" email to the client/candidate after their message reaches us.
# It never repeats what they typed (anti-spam-relay). Enable once sending from nextmadelabs.com is verified.
SEND_CONFIRMATION_EMAILS=false

# ── Saved submissions (one-click forms) ─────────────────────────────────────────────────────────────────────
# Every accepted application/inquiry is saved before email is attempted. Locally: .data/submissions (default).
# On Vercel the filesystem isn't durable, so set the Upstash variables below; they store submissions too.
# "off" disables file storage.
SUBMISSIONS_DIR=

# ── Optional integrations ─────────────────────────────────────────────────────────────────────────────────────
# HubSpot private-app token (scope: crm.objects.contacts.write). Project inquiries only — never applications.
HUBSPOT_ACCESS_TOKEN=
# Distributed rate limiting (strongly recommended on Vercel/serverless). Without it, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-IP limit for each form, separately. Defaults: 5 submissions per 600 seconds.
INTAKE_RATE_LIMIT_MAX=
INTAKE_RATE_LIMIT_WINDOW_SECONDS=
