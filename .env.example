# Copy to .env.local for local development, or set these in your hosting provider.
# Everything is optional: with nothing set, the site runs in safe "unconfigured" mode
# (no indexing, no fake contact details, inquiry form shows a copyable summary instead of "sent").

# ── Public (inlined into the browser bundle at BUILD time — rebuild after changing) ──────────
# Canonical base URL, no trailing slash. Enables canonical tags, absolute OG URLs, JSON-LD, sitemap hosts.
NEXT_PUBLIC_SITE_URL=
# Set to "true" only on the production deployment once content is final.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Public inbox shown on the site and used for mailto fallbacks.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional separate inbox for job interest (falls back to NEXT_PUBLIC_CONTACT_EMAIL).
NEXT_PUBLIC_CAREERS_EMAIL=
# Real booking page (Cal.com, Calendly, HubSpot Meetings…). Leave empty if none.
NEXT_PUBLIC_SCHEDULING_URL=
# Social profiles (leave empty to hide).
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# ── Server-only secrets (read at request time by /api/inquiry; never exposed to the browser) ──
# Resend (https://resend.com): API key with "sending" permission.
RESEND_API_KEY=
# Where inquiries are delivered. Comma-separate multiple addresses.
INQUIRY_TO_EMAIL=
# Sender on a domain you have verified in Resend, e.g. "Nextmade Website <inquiries@yourdomain.com>".
INQUIRY_FROM_EMAIL=

# Optional HubSpot private-app token (scope: crm.objects.contacts.write) to also create a CRM contact.
HUBSPOT_ACCESS_TOKEN=

# Optional distributed rate limiting (strongly recommended on serverless hosting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Defaults: 5 submissions per IP per 600 seconds.
INQUIRY_RATE_LIMIT_MAX=
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=
